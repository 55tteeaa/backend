generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  department String
  role       Role      @default(STUDENT)
  bookings   Booking[]
}

model Resource {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  subtitle         String
  description      String
  department       String
  equipmentType    String
  location         String
  requiresApproval Boolean   @default(false)
  maxHours         Int       @default(4)
  rules            String[]
  bookings         Booking[]
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id])
  date       String
  startHour  Int
  endHour    Int
  purpose    String
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  @@index([resourceId, date])
}
